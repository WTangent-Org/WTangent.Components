<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 契约项目：组件运行时引用（lib/net10.0 进包） -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WTangent.Core</RootNamespace>
    <AssemblyName>WTangent.Core</AssemblyName>
    <Version>0.0.5</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- IEntry.Commands 是 System.CommandLine.Command[]，契约引用它 -->
    <PackageReference Include="System.CommandLine" Version="2.0.10"/>
  </ItemGroup>

</Project>
