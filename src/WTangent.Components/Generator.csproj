<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 生成器项目：编译器加载（analyzers/dotnet/cs 进包） -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RootNamespace>WTangent.Components</RootNamespace>
    <AssemblyName>WTangent.Components</AssemblyName>
    <Version>0.0.10</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- RS1035：分析器禁文件 IO——此处刻意为之（写 agent-component.json 到仓根，内容不变不写、失败不炸构建） -->
    <NoWarn>$(NoWarn);CS1591;RS1035</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all"/>
  </ItemGroup>

</Project>
