<Project Sdk="Microsoft.NET.Sdk">

  <!-- 打包项目：把生成器（analyzers）+ 契约（lib）收拢进一个 NuGet 包。
       不 ProjectReference（restore 对项目名歧义）；先构建 src 两个项目再 pack（CI 已按序执行）。 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>WTangent.Components</PackageId>
    <Version>0.1.0</Version>
    <Description>wtangent 组件共享包：源生成器（[AgentComponent]/[AgentDefault]/[AgentTool] → Entry）+ 运行时契约（ITool/Application/Http）</Description>
    <!-- netstandard2.0 自身无 lib 产物（内容经 TfmSpecificPackageFile 注入），NU5128 属预期 -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- 打包项目不编译任何源码（src 由各自项目构建，产物经 TfmSpecificPackageFile 注入包） -->
  <ItemGroup>
    <Compile Remove="src/**"/>
    <None Remove="src/**"/>
    <Content Remove="src/**"/>
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddTfmPackageContent</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="AddTfmPackageContent">
    <ItemGroup>
      <TfmSpecificPackageFile Include="src\WTangent.Components\bin\$(Configuration)\netstandard2.0\WTangent.Components.dll" PackagePath="analyzers/dotnet/cs"/>
      <TfmSpecificPackageFile Include="src\WTangent.Core\bin\$(Configuration)\net10.0\WTangent.Core.dll" PackagePath="lib/net10.0"/>
    </ItemGroup>
  </Target>

</Project>
