<Project>
  <!-- 生成器写 agent-component.json 需要的 MSBuild 属性（项目目录 / 程序集名）；
       随包 buildTransitive 流入所有消费方 -->
  <ItemGroup>
    <CompilerVisibleProperty Include="ProjectDir" />
    <CompilerVisibleProperty Include="AssemblyName" />
    <!-- 组件间依赖声明（csproj 的 ComponentDepends="别名:最低版本;..."）→ 生成器写进 agent-component.json 的 depends -->
    <CompilerVisibleProperty Include="ComponentDepends" />
  </ItemGroup>
</Project>
